{
  "name": "draandreaesparza-com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "include": [
      "/",
      "/articulos/conceptos-ninez-adolescencia-dip",
      "/articulos/bioetica-reproduccion-asistida-subrogacion-vientres",
      "/articulos/finanzas-islamicas-derecho-musulman",
      "/articulos/identidad-de-genero-analisis-fallo",
      "/articulos/historia-derecho-musulman-sustraccion-menores",
      "/articulos/interes-superior-nino-tratados-internacionales",
      "/articulos/analisis-problemas-dip-divorcio-internacional"
    ]
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "react-snap": "^1.23.0",
    "vite": "^7.1.6"
  }
}
